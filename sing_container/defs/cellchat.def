Bootstrap: docker
From: bioconductor/bioconductor_docker:RELEASE_3_19-R-4.4.0

%post
    apt-get update
    
    # Install R packagers
    R -e "install.packages('BiocManager')"
    R -e "BiocManager::install(c('BiocGenerics','ComplexHeatmap','BiocNeighbors','Biobase'))"
    R -e "packages = c('dplyr','devtools','jsonlite','ggplot2','ggpubr','stringr','optparse','NMF') ; install.packages(packages,dependencies = TRUE)"
    R -e "devtools::install_github('jinworks/CellChat')"
    R -e "devtools::install_github('immunogenomics/presto')"
